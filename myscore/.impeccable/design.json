      "kind": "button",
      "refersTo": "button-watch",
      "description": "赛程行中的播放操作；内联线性 SVG。",
      "html": "<button class=\"ds-watch\" aria-label=\"观看比赛\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 5 11 7-11 7z\"/></svg></button>",
      "css": ".ds-watch{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-width:40px;min-height:40px;padding:8px;border:1px solid var(--line,#d8e1ee);border-radius:8px;background:var(--surface,#fff);color:var(--link,#2446be);cursor:pointer;font-family:var(--sans,'Score Sans','PingFang SC','Microsoft YaHei',sans-serif);}.ds-watch svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-watch:hover{background:var(--wash,#e9efff);border-color:var(--blue,#244be2)}.ds-watch:focus-visible{outline:3px solid var(--blue,#244be2);outline-offset:3px;}"
    },
