      "description": "工具栏及阅读视图轻操作。",
      "html": "<button class=\"ds-text\">今天</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-width:40px;min-height:40px;border:1px solid transparent;border-radius:8px;background:none;padding:8px 13px;color:var(--link,#2446be);font-size:13px;cursor:pointer;font-family:var(--sans,'Score Sans','PingFang SC','Microsoft YaHei',sans-serif);}.ds-text:hover{background:var(--wash,#e9efff)}.ds-text:focus-visible{outline:3px solid var(--blue,#244be2);outline-offset:3px;}.ds-text:disabled{cursor:default;color:var(--muted,#57677f)}"
    },
