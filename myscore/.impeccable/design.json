      "html": "<nav class=\"ds-games\" aria-label=\"小局\"><a href=\"#game-1\" aria-current=\"page\">第 1 局</a><a href=\"#game-2\">第 2 局</a></nav>",
      "css": ".ds-games{display:flex;gap:6px;overflow:auto;font-family:var(--sans,'Score Sans','PingFang SC','Microsoft YaHei',sans-serif);}.ds-games a{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:6px 14px;border:1px solid var(--line,#d8e1ee);border-radius:7px;color:var(--muted,#57677f);font-size:13px;white-space:nowrap;text-decoration:none}.ds-games a[aria-current]{color:var(--link,#2446be);background:var(--wash,#e9efff);border-color:var(--blue,#244be2);font-weight:600}.ds-games a:hover{background:var(--wash,#e9efff)}.ds-games a:focus-visible{outline:3px solid var(--blue,#244be2);outline-offset:3px;}"
